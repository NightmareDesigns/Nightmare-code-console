{
  "name": "nightmare-code-console",
  "version": "1.0.0",
  "description": "AI-powered code editor with Matrix background and Nightmare theme",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node scripts/build-android.js",
    "build:standalone:win": "npm run build && pkg . --targets node18-win-x64 --output releases/nightmare-code-console-win.exe",
    "build:standalone": "npm run build:standalone:win",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "highlight.js": "^11.9.0",
    "marked": "^9.1.6",
    "monaco-editor": "^0.44.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.16.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "outputPath": "releases"
  },
  "keywords": [
    "code-editor",
    "ai",
    "nightmare",
    "matrix",
    "ide"
  ],
  "author": "NightmareDesigns",
  "license": "MIT"
}

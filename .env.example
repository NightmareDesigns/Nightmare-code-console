NODE_ENV=development
PORT=3000

# AI Configuration (set your API key here)
# Supports OpenAI-compatible APIs
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-3.5-turbo

# Set to 'true' to enable mock AI responses when no API key is set
AI_MOCK_MODE=true

# ─── Gemini (Google AI Studio) ──────────────────────────────
# Use these to default the server to Gemini (especially useful for
# packaged Windows builds when you drop a .env beside the EXE)
# AI_PROVIDER=gemini
# AI_GEMINI_API_KEY=your_gemini_api_key
# AI_GEMINI_MODEL=gemini-1.5-flash   # other options: gemini-1.5-pro, gemini-1.5-flash-8b, gemini-1.5-flash-lite

# ─── Local AI (Ollama / LM Studio) ───────────────────────────
# To use a locally-running model, set AI_API_URL to your local
# Ollama endpoint (no API key required) and choose a model.
#
# Install Ollama: https://ollama.com
# Pull a model:   ollama pull codellama:7b
#                 ollama pull deepseek-coder:6.7b
#                 ollama pull mistral:7b
#
# Then switch to local mode by updating the values below:
#
# AI_API_URL=http://localhost:11434/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=codellama:7b
# AI_MOCK_MODE=false
#
# For LM Studio use http://localhost:1234/v1/chat/completions

# ─── Local-first desktop default (Windows/macOS/Linux) ───────
# If you want the app to automatically use a local model when no
# cloud API key is set, enable this block. This is handy on
# Windows 10 with Ollama or LM Studio running locally.
#
# AI_PREFER_LOCAL=true
# AI_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
# AI_LOCAL_MODEL=codellama:7b
# AI_LOCAL_API_KEY=
# ─────────────────────────────────────────────────────────────

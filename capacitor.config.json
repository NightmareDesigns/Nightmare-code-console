{
  "appId": "com.nightmaredesigns.codeconsole",
  "appName": "Nightmare Code Console",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "plugins": {
    "CapacitorNodeJS": {
      "nodeDir": "nodejs"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
